# Built on the user's machine by setup.cmd — never committed.
server/.venv/

# ffmpeg is downloaded by setup.cmd (too big for git, and often already on the
# user's PATH). ExifTool IS committed (redistributable, git-safe).
server/tools/ffmpeg.exe
server/tools/ffprobe.exe

# Written by setup.cmd on the user's machine — the full output of every setup
# step, shown only if something fails.
setup-log.txt

# Written by the app on every launch — the backend's own output, so a server
# that dies on startup leaves a readable trace instead of a console window that
# closes too fast to read.
server-log.txt

# Python bytecode
__pycache__/
*.pyc

# ML models download on first index into the user's own data dir, never here.

# OS noise
Thumbs.db
Desktop.ini
